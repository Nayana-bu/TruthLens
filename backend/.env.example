# Backend Server Configuration
# Standalone backend defaults to 4000 when SERVE_FRONTEND=false, or 3000 in unified preview mode.
PORT=4000
NODE_ENV=development

# Google Gemini API Key (server-side ONLY — never expose in frontend/.env)
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# Allowed Frontend Origins for CORS (comma-separated)
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# Set to "true" to let Express also mount Vite/dist frontend, or "false" for API-only mode
SERVE_FRONTEND=false

# Session HMAC signing secret (auto-derived fallback used in local dev if omitted)
AUTH_SECRET="CHANGE_ME_LOCAL_DEV_AUTH_SECRET"

# Public deployment URL (optional)
APP_URL="http://localhost:4000"
