# Frontend Configuration (Public client-side variables only — NEVER place secret API keys here)

# Base URL for backend API requests.
# Leave blank when using Vite dev proxy (/api) or unified same-origin hosting on port 3000.
# For cross-origin standalone setups, set e.g. http://localhost:4000
VITE_API_BASE_URL=""

# Vite development server proxy target for /api requests when running frontend independently
VITE_API_PROXY_TARGET="http://localhost:4000"
