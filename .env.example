# TruthLens Verify — Root Environment Example
# For separated standalone development, configure backend/.env and frontend/.env
# (see backend/.env.example and frontend/.env.example).

# GEMINI_API_KEY: Server-side Google Gemini API key (NEVER expose in frontend/.env).
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# PORT: Unified preview server port (defaults to 3000 in dev when SERVE_FRONTEND=true).
PORT=3000

# CORS_ORIGIN: Comma-separated allowed frontend origins for standalone mode.
CORS_ORIGIN="http://localhost:5173,http://localhost:3000"

# AUTH_SECRET: HMAC signing secret for backend auth tokens (optional in local dev).
AUTH_SECRET="CHANGE_ME_LOCAL_DEV_AUTH_SECRET"

# APP_URL: Public base URL where the app is hosted (optional).
APP_URL="MY_APP_URL"
